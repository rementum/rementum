# Only useful when a www record points at this host; without one Caddy retries certificate
# issuance for the name in the background, which is noisy in the logs but harmless.
www.{$REMENTUM_DOMAIN:localhost} {
	redir https://{$REMENTUM_DOMAIN:localhost}{uri} permanent
}

{$REMENTUM_DOMAIN:localhost} {
	encode zstd gzip
	# The API accepts archives of up to 100 MB plus multipart overhead; nothing larger is
	# legitimate, so it is refused at the edge before any service buffers it.
	request_body {
		max_size 110MB
	}
	log {
		output stdout
		format json
	}

	@backend path /api/* /mcp/* /.well-known/* /oauth/* /healthz /readyz /metrics
	handle @backend {
		reverse_proxy api:8787
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		-Server
	}
}
