Output docs/assets/rementum-demo.gif
Output docs/assets/rementum-demo.mp4

Set FontSize 14
Set FontFamily "JetBrains Mono"
Set Width 1240
Set Height 580
Set Theme { "background": "#091514", "foreground": "#F3F5F1", "black": "#091514", "brightBlack": "#2B3A37", "red": "#FF5F57", "brightRed": "#FF7B72", "green": "#4AA48F", "brightGreen": "#9EC9C1", "yellow": "#F59E0B", "brightYellow": "#FBBF24", "blue": "#4AA48F", "brightBlue": "#9EC9C1", "magenta": "#9EC9C1", "brightMagenta": "#C4E2DC", "cyan": "#4AA48F", "brightCyan": "#9EC9C1", "white": "#F3F5F1", "brightWhite": "#FFFFFF" }
Set Padding 20
Set WindowBar Colorful
Set Framerate 30

Hide
Type "node scripts/demo-hero.mjs"
Enter
Sleep 600ms
Show
Sleep 16s
