# Public origin shared by the web app, session API, and MCP OAuth endpoints.
NODE_ENV=development
REMENTUM_PUBLIC_URL=http://localhost
REMENTUM_DATABASE_URL=postgres://owl_app:change-me@postgres:5432/owl
REMENTUM_DATABASE_ADMIN_URL=postgres://postgres:change-admin-password@postgres:5432/owl
REMENTUM_POSTGRES_PASSWORD=change-me
REMENTUM_POSTGRES_SUPER_PASSWORD=change-admin-password
REMENTUM_POSTGRES_PORT=55432

# Master key wrapping brain keys. In production, install.sh generates a fresh random 32-byte key.
# For local evaluation, this default 32-byte base64 key works out of the box.
REMENTUM_MASTER_KEY=bG9jYWwtZGV2LW1hc3Rlci1rZXktZm9yLXRlc3QzMmI=

# Cookie signing keys. In production, install.sh generates fresh random keys.
REMENTUM_COOKIE_KEYS=local-dev-cookie-secret-key-minimum-16-chars
REMENTUM_JWT_JWKS=

# Local blob storage inside the API/worker volume.
REMENTUM_BLOB_DIR=/data/blobs
REMENTUM_EXPORT_DIR=/data/exports

# Registration is invitation-only by default.
REMENTUM_ALLOW_SIGNUP=false
REMENTUM_DEV_AUTH=false
REMENTUM_LOG_LEVEL=info

# Reverse proxies whose X-Forwarded-For entries are believed, as IPs, CIDRs, or the presets
# loopback, linklocal, and uniquelocal. Everything outside the list counts as the client, so a
# request cannot spoof its address and reset its rate-limit bucket. Leave empty when the API is
# exposed directly.
REMENTUM_TRUSTED_PROXIES=loopback,uniquelocal
REMENTUM_EMBEDDINGS_URL=http://embeddings:8790
# Changing the model does not require a migration: vectors are stamped with the model that
# produced them, search only ranks vectors from the active model, and the worker's hourly
# maintenance pass re-embeds every article it finds indexed under anything else.
REMENTUM_EMBEDDING_MODEL=onnx-community/granite-embedding-97m-multilingual-r2-ONNX
# Pooling, prefixes, and dtype are resolved from the model family (granite and e5 are known).
# Set these only for a model the service does not recognize, or to force a dtype.
# REMENTUM_EMBEDDING_DTYPE=q8
# REMENTUM_EMBEDDING_POOLING=cls
# REMENTUM_EMBEDDING_QUERY_PREFIX=
# REMENTUM_EMBEDDING_PASSAGE_PREFIX=

# Optional provider capability. No content is sent until an owner/admin also enables compaction on
# a workspace. Promoted versions are queued and compacted by the worker in the background.
# The provider/model must support strict JSON Schema through Chat Completions response_format.
# REMENTUM_LLM_BASE_URL is the API root that contains /chat/completions, such as .../v1.
REMENTUM_LLM_ENABLED=false
REMENTUM_LLM_BASE_URL=
REMENTUM_LLM_MODEL=
REMENTUM_LLM_API_KEY=
# Optional reasoning effort for reasoning models: none, minimal, low, medium, or high.
# Leave empty to omit the parameter from requests.
REMENTUM_LLM_REASONING_EFFORT=
REMENTUM_LLM_TIMEOUT_MS=45000
REMENTUM_LLM_MAX_INPUT_CHARS=24000
REMENTUM_LLM_CONCURRENCY=4
REMENTUM_COMPACTION_POLL_MS=2000

# Transactional account and invitation email through Resend.
REMENTUM_RESEND_API_KEY=
# Example: Rementum <rementum@example.com>
REMENTUM_MAIL_FROM=

# Optional Cloudflare Turnstile bot protection on the account forms.
# Set both keys together; leave both empty to disable the challenge.
REMENTUM_TURNSTILE_SITE_KEY=
REMENTUM_TURNSTILE_SECRET_KEY=

# Encrypted backups are written to this host directory.
REMENTUM_BACKUP_HOST_DIR=./backups
REMENTUM_BACKUP_AGE_RECIPIENT=

# Caddy hostname.
REMENTUM_DOMAIN=localhost
