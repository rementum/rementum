# Public URL used by OAuth metadata and callbacks.
NODE_ENV=development
OWL_PUBLIC_URL=https://owl.example.com
OWL_DATABASE_URL=postgres://owl_app:change-me@postgres:5432/owl
OWL_DATABASE_ADMIN_URL=postgres://postgres:change-admin-password@postgres:5432/owl
OWL_POSTGRES_PASSWORD=change-me
OWL_POSTGRES_SUPER_PASSWORD=change-admin-password
OWL_POSTGRES_PORT=55432

# Generate with: openssl rand -base64 32
# This key is never included in backups. Losing it makes encrypted bodies unrecoverable.
OWL_MASTER_KEY=

# Generate with: openssl rand -base64 32
OWL_COOKIE_KEYS=
OWL_JWT_JWKS=

# Local blob storage inside the API/worker volume.
OWL_BLOB_DIR=/data/blobs
OWL_EXPORT_DIR=/data/exports

# Registration is invitation-only by default.
OWL_ALLOW_SIGNUP=false
OWL_DEV_AUTH=false
OWL_LOG_LEVEL=info
OWL_EMBEDDINGS_URL=http://embeddings:8790
OWL_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Required. Staging sends the plaintext candidate body to this OpenAI-compatible provider.
# OWL_LLM_BASE_URL is the API root that contains /chat/completions, such as .../v1.
OWL_LLM_ENABLED=true
OWL_LLM_BASE_URL=https://api.openai.com/v1
OWL_LLM_MODEL=
OWL_LLM_API_KEY=
# Optional reasoning effort for reasoning models: none, minimal, low, medium, or high.
# Leave empty to omit the parameter from requests.
OWL_LLM_REASONING_EFFORT=
OWL_LLM_TIMEOUT_MS=45000
OWL_LLM_MAX_INPUT_CHARS=24000
OWL_LLM_CONCURRENCY=4

# Transactional account and invitation email through Resend.
OWL_RESEND_API_KEY=
# Example: Owl Memory <owl@example.com>
OWL_MAIL_FROM=

# Encrypted backups are written to this host directory.
OWL_BACKUP_HOST_DIR=./backups
OWL_BACKUP_AGE_RECIPIENT=

# Caddy hostname.
OWL_DOMAIN=localhost
